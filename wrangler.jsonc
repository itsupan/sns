{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sns",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },

	"vars": {
		"BETTER_AUTH_URL": "http://localhost:5173"
	},
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sns-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "00000000000000000000000000000000"
		}
	],

	"env": {
		"production": {
			"name": "sns",
			"vars": {
				"BETTER_AUTH_URL": "https://sns.ecoapsara.com"
			},
			"routes": [{ "pattern": "sns.ecoapsara.com", "custom_domain": true }],
			"secrets": {
				"required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "sns-prod",
					"database_id": "57a1a8fc-6d6e-4974-b5d1-2279cbe2c263",
					"migrations_dir": "migrations"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "fa46fc4c9e684fbbb1f38509a177509b"
				}
			]
		}
	}
}
